{
  "name": "en16931-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter '*' build",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "bench": "bun run --filter en16931 bench",
    "parity": "bun run --filter en16931 parity",
    "pkg-check": "bun run --filter en16931 pkg-check",
    "verify": "bun run lint && bun run typecheck && bun run test && bun run pkg-check"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.0",
    "@biomejs/biome": "^2.5.7",
    "@types/bun": "^1.3.14",
    "@types/node": "^22.0.0",
    "publint": "^0.3.0",
    "typescript": "^5.9.0"
  }
}
